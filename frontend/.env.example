# frontend/.env.local (ห้าม commit) — คัดลอกจากไฟล์นี้
# backend ที่ frontend proxy /api/* และ /auth/* ไปหา
BACKEND_URL=http://127.0.0.1:4208
# ต้องตรงกับ name ใน subsystem.yaml และทะเบียน Core Hub
SUBSYSTEM_ID=csmju-cloudflow
# หน้าเว็บ Core Hub (portal ที่ผู้ใช้ login) — ปุ่ม "กลับ CSMJU Portal" ใน CsmjuAppShell พาไปที่นี่
# ไม่ตั้ง = ไม่แสดงปุ่ม · ต้องเป็นค่าเดียวกับ CORE_HUB_WEB_URL ของ backend · image ของ server ใช้ค่าจริงอยู่แล้ว
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
