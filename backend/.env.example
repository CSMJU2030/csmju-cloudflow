# ───────────────────────────────────────────────────────────────
# CS-CloudFlow — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
#   cp .env.example .env        (Windows: copy .env.example .env)
# ⚠️ ห้าม commit ไฟล์ .env  — อยู่ใน .gitignore แล้ว
# ───────────────────────────────────────────────────────────────

# PostgreSQL — รูปแบบ postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# ถ้ารหัสผ่านมีอักขระพิเศษ (@ : / ? # &) ต้อง URL-encode ก่อน
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/cs_cloudflow?schema=public"

# กุญแจเซ็น JWT — ห้ามใช้ค่านี้บนเครื่องจริง
# สุ่มค่าใหม่:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="<RANDOM_SECRET>"
JWT_EXPIRES_IN="8h"

# เซิร์ฟเวอร์
PORT=4000
HOST=127.0.0.1
