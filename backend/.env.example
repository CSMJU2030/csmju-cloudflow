# ---------------------------------------------------------------------------
# CS-CloudFlow backend — คัดลอกเป็น backend/.env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง (ห้าม commit .env)
# ขั้นตอนเชื่อม Core Hub จริงทั้งหมด: standards/docs/connect-core-hub.md
# ---------------------------------------------------------------------------

NODE_ENV=development
# dev: backend ใช้พอร์ต 42xx ของทีม · frontend คู่กันใช้ 3208 · บน server: PORT=4000 · เว็บจริง https://csmju-cloudflow.jowave.com
PORT=4208
# dev เท่านั้น — ใน container image ตั้ง HOST=0.0.0.0 ไว้แล้ว (ห้ามใส่ HOST ใน env ของ server ไม่งั้น web ต่อ api ไม่ได้)
HOST=127.0.0.1

# ฐานข้อมูลของระบบนี้เท่านั้น — ห้ามชี้ไปที่ฐานของ Core Hub
# รูปแบบ postgresql://USER:PASSWORD@HOST:PORT/DBNAME · รหัสผ่านที่มี @ : / ? # & ต้อง URL-encode
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/cs_cloudflow?schema=public
# จำนวน connection สูงสุดต่อระบบ — ฐานกลางบน server ใช้ร่วมกัน (deployment.md ข้อ 4.1)
DATABASE_POOL_MAX=5

# Core Hub (ผู้ให้ identity) — server จริง · อ่านจาก env เสมอ ห้ามเขียนตายในโค้ด
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
# เว็บของ Core Hub ที่ GET /auth/login ส่งเบราว์เซอร์ไป (/sso/authorize) และ POST /auth/logout ส่งไป (/logout)
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# สัญญาที่ตรึงไว้ — ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของระบบ — ต้องตรงกับ name ใน Subsystem Registry และ subsystem.yaml
SUBSYSTEM_ID=csmju-cloudflow

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# cache ข้อมูลอ้างอิงจาก Core Hub (รายวิชา) — reference-data.md ข้อ 7.3
CORE_HUB_DATA_CACHE_TTL_MS=600000
CORE_HUB_DATA_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000

# ── ระบบยืมพื้นที่ cloud storage ──
# ไม่ตั้ง STORAGE_SECRET_KEY = ระบบยืมพื้นที่ปิด (endpoint /api/v1/storage-* ตอบ 503) ส่วนอื่นทำงานตามเดิม
# สร้างกุญแจ: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ห้าม commit ค่าจริง · ทำกุญแจหาย = ถอดลิงก์ที่เก็บไว้ไม่ได้
STORAGE_SECRET_KEY=
# fake = cloud จำลอง (โฟลเดอร์ในเครื่อง) จนกว่าจะได้ cloud จริง
STORAGE_PROVIDER=fake
# โฟลเดอร์ของ cloud จำลอง — ต้องอยู่นอก repo · ไม่ตั้ง = โฟลเดอร์ temp ของเครื่อง
STORAGE_FAKE_ROOT=
STORAGE_POOL_NAME=cs-cloud-01
# หน่วย MiB · 1 TiB = 1048576 · 15 GiB = 15360 (seed ใช้ตั้งขนาด pool)
STORAGE_POOL_TOTAL_MIB=1048576
STORAGE_MAX_PER_USER_MIB=15360
# งานตั้งเวลา (ปิดลิงก์ตอนหมดอายุ · ลบพื้นที่ · sync ขนาดที่ใช้ · ลองสร้างใหม่) — false = ปิดเฉพาะการรันอัตโนมัติ
STORAGE_JOBS_ENABLED=true
# เก็บไฟล์ไว้กี่วันหลังปิดลิงก์ ก่อนลบจริง
STORAGE_RETENTION_DAYS=14
STORAGE_MAX_PROVISION_ATTEMPTS=5
